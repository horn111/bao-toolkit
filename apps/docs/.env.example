# Server-side only. Create a query from dune/builder-code-activity.sql.
DUNE_API_KEY=
DUNE_ACTIVITY_QUERY_ID=

# Set true only after the query also returns correctly attributed ERC-4337
# operations, with user_op_hash, user_op_sender and user_op_calldata columns.
DUNE_ACTIVITY_INCLUDES_USEROPS=false
