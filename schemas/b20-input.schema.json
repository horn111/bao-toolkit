{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BAO B20 transaction input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "chainId", "selection", "transactions"],
  "properties": {
    "kind": { "const": "bao.b20-input" },
    "schemaVersion": { "const": 1 },
    "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "description", "completeness"],
      "properties": {
        "mode": {
          "enum": ["explicit-hashes", "application-export", "builder-code-filtered", "sample"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "completeness": { "enum": ["unknown", "producer-declared"] }
      }
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hash"],
        "properties": { "hash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" } }
      }
    }
  }
}
